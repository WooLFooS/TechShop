<Page x:Class="TechShop.Components.ServiceListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TechShop.Components"
      mc:Ignorable="d" 
      d:DesignHeight="890" d:DesignWidth="1700"
      Title="ServiceListPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"></RowDefinition>
            <RowDefinition Height="6*"></RowDefinition>
            <RowDefinition Height="1*"></RowDefinition>
        </Grid.RowDefinitions>
        <StackPanel Background="White" Orientation="Horizontal">
            <ComboBox x:Name="SortCb" Margin="50,0,0,0" SelectionChanged="SortCb_SelectionChanged">
                <ComboBoxItem>По умолчанию</ComboBoxItem>
                <ComboBoxItem>По возрастанию</ComboBoxItem>
                <ComboBoxItem>По убыванию</ComboBoxItem>
            </ComboBox>
            <Label Content="Фильтрация по скидке" VerticalAlignment="Center" Margin="250,0,0,0"></Label>
            <ComboBox x:Name="DiscountFiltrCb" Margin="0,0,0,0" SelectionChanged="DiscountFiltrCb_SelectionChanged">
                <ComboBoxItem>Все</ComboBoxItem>
                <ComboBoxItem>от 0% до 5%</ComboBoxItem>
                <ComboBoxItem>от 5% до 15%</ComboBoxItem>
                <ComboBoxItem>от 15% до 30%</ComboBoxItem>
                <ComboBoxItem>от 30% до 70%</ComboBoxItem>
                <ComboBoxItem>от 70% до 100%</ComboBoxItem>
            </ComboBox>
            <StackPanel Orientation="Vertical" Margin="200,20,0,0">
                <TextBlock>По названию или описанию</TextBlock>
                <TextBox x:Name="SearchTb" TextChanged="SearchTb_TextChanged" Width="230"></TextBox>
            </StackPanel>
        </StackPanel>
        
        <ScrollViewer Grid.Row="1" Background="White" HorizontalScrollBarVisibility="Disabled">
            <WrapPanel x:Name="ServiceWp"/>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Background="White">
            <Button x:Name="AddBtn" Width="250" Content="ДОБАВИТЬ" HorizontalAlignment="Left" Margin="300,30,0,0" Click="AddBtn_Click"></Button>
            <TextBlock Margin="500,-60,0,0" x:Name="CountDataTb" Width="200" Height="70"></TextBlock>
            
        </StackPanel>
    </Grid>
</Page>
