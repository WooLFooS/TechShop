<UserControl x:Class="TechShop.Components.ServiceUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TechShop.Components"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="225"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="75"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Height="200" Width="380">
            <Image x:Name="ImageProduct" ></Image>
        </StackPanel>
        <Label Grid.Row="1" x:Name="NameProductLb"></Label>
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Width="400" Height="50" Orientation="Horizontal">
            <Image Source="/Resources/Zvezda.png" ></Image>
            <Label Width="130" x:Name="RaitingLb"></Label>
            <Label Width="130"></Label>
        </StackPanel>
        <StackPanel Grid.Row="3" Width="400" Height="50" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
            <Label Width="200" x:Name="OriginalPriceLb" FontSize="25"></Label>
            <Label Width="200" x:Name="FirstPriceLb"></Label>
        </StackPanel>
        <StackPanel Grid.Row="4" Width="400" Height="75" Orientation="Horizontal">
            <Button x:Name="BuyBt">
                <Image Source="/Resources/buy.png" ></Image>
            </Button>
            <Button x:Name="LikeBt">
                <Image Source="/Resources/like.png"></Image>
            </Button>
            <Button x:Name="RatingBt">
                <Image Source="/Resources/Raiting.png" Height="40" ></Image>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
