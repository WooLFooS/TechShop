<UserControl x:Class="TechShop.Components.ServiceUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TechShop.Components"
             mc:Ignorable="d" 
             d:DesignHeight="590" d:DesignWidth="365">
    <Grid>
        <Border Background="Black"></Border>
        <Border BorderThickness="3" Background="White"></Border>
        <StackPanel HorizontalAlignment="Center" Width="365">

            <StackPanel Margin="0 10 0 10" Orientation="Horizontal">
                <Image Height="150" Width="274" x:Name="ImageProduct"></Image>
                <TextBlock x:Name="DiscountTb" HorizontalAlignment="Center" VerticalAlignment="Bottom"></TextBlock>
            </StackPanel>

            <StackPanel Margin="0 0 0 15">
                <Button x:Name="EditImageBtn" Width="352">Изменить изображение</Button>
            </StackPanel>

            <StackPanel Width="352" Height="50" Margin="0 0 0 15">
                <TextBlock x:Name="NameProductTb" TextWrapping="Wrap" Height="50"></TextBlock>
            </StackPanel>

            <StackPanel Margin="0 0 0 15" HorizontalAlignment="Center" VerticalAlignment="Center" Width="352" Height="50" Orientation="Horizontal">
                <Image Source="/Resources/Zvezda.png" ></Image>
                <TextBlock Width="200" x:Name="RaitingTb"></TextBlock>
            </StackPanel>

            <StackPanel Margin="0 0 0 15" Width="352" Height="50" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock Width="174" x:Name="OriginalPriceLb" FontSize="25" TextDecorations="Strikethrough"></TextBlock>
                <TextBlock Width="174" x:Name="FirstPriceLb"></TextBlock>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Button x:Name="BuyBt">
                    <Image Source="/Resources/buy.png" ></Image>
                </Button>
                <Button x:Name="LikeBt">
                    <Image Source="/Resources/like.png"></Image>
                </Button>
                <Button x:Name="RatingBt">
                    <Image Source="/Resources/Raiting.png" Height="40" ></Image>
                </Button>
            </StackPanel>

        </StackPanel>
        
    </Grid>
</UserControl>
