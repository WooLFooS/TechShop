<Page x:Class="TechShop.Components.AddEditServicePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TechShop.Components"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddEditServicePage">

    <Grid Background="black" HorizontalAlignment="Center">
        <Border Background="Black" BorderThickness="3" Margin="5" Width="270">
            <StackPanel Background="white">
                <Image x:Name="ImageProduct" Width="150" Height="100" Source="{Binding MainImagePath}"></Image>
                <Button x:Name="AddImageBtn" Content="Добавить картинку" Width="200" Click="AddImageBtn_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Label Content="Название"></Label>
                    <TextBox x:Name="TitleTb" Background="White" Width="160" Text="{Binding Title}"></TextBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Label Content="Скидка"></Label>
                    <TextBox Background="White" Width="160" Text="{Binding Discount}" x:Name="DiscountTb"></TextBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Label Content="Цена"></Label>
                    <TextBox Background="White" Width="160" Text="{Binding Cost}" x:Name="CostTb"></TextBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Label Content="Описание"></Label>
                    <TextBox Background="White" Width="160" Text="{Binding Description}" x:Name="DescriptionTb"></TextBox>
                </StackPanel>
                <Button Content="Сохранить" x:Name="SaveBtn" Width="200" Click="SaveBtn_Click"></Button>
            </StackPanel>

        </Border>
    </Grid>
</Page>
