<Window x:Class="TechShop.Components.AddEditServicePage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TechShop.Components"
        mc:Ignorable="d"
        Title="AddEditServicePage" Height="450" Width="300">
    <Grid Background="black" HorizontalAlignment="Center">
        <Border Background="Black" BorderThickness="3" Margin="5" Width="270">
            <StackPanel Background="white">
                <Image x:Name="ImageProduct" Width="150" Height="100" Source="{Binding MainImagePath}"></Image>
                <Button x:Name="AddImageBtn" Content="Добавить картинку" Width="200" Click="AddImageBtn_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Label Content="Название"></Label>
                    <TextBox Background="White" Width="160" Text="{Binding Discount}"></TextBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Label Content="Скидка"></Label>
                    <TextBox Background="White" Width="160" Text="{Binding Discount}"></TextBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Label Content="Цена"></Label>
                    <TextBox Background="White" Width="160" Text="{Binding Discount}"></TextBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Label Content="Описание"></Label>
                    <TextBox Background="White" Width="160" Text="{Binding Discount}"></TextBox>
                </StackPanel>
                <Button Content="Сохранить" x:Name="SaveBtn" Width="200"></Button>
            </StackPanel>
            
        </Border>
    </Grid>
</Window>
