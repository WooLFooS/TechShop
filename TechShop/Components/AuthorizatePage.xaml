<Page x:Class="TechShop.Components.AuthorizatePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TechShop.Components"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthorizatePage">

    <Grid>
        <StackPanel Background="White" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button x:Name="EnterBtn" Content="ВОЙТИ" Width="500" Height="70" Margin="30" Click="EnterBtn_Click"></Button>
            <Label Content="Администратор - введите код" HorizontalAlignment="Center"></Label>
            <PasswordBox x:Name="PasswordPb" BorderThickness="3" BorderBrush="#FF04A0FF" Width="100" Margin="30"></PasswordBox>
        </StackPanel>
    </Grid>
</Page>
